# Copier vers .env et adapter. Ne jamais committer .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=url_monitor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=url_monitor
# Port exposé sur l'hôte (127.0.0.1) ; 5433 évite un conflit avec un Postgres local.
POSTGRES_PORT=5433

# --- Application (valeurs côté hôte ; docker compose surcharge DATABASE_URL/REDIS_URL) ---
DATABASE_URL=postgresql+asyncpg://url_monitor:change-me@localhost:5433/url_monitor
REDIS_URL=redis://localhost:6379/0

# Base dédiée aux tests (créée par docker/postgres-init.sql)
TEST_DATABASE_URL=postgresql+asyncpg://url_monitor:change-me@localhost:5433/url_monitor_test

# --- Auth ---
# Au moins 32 caractères. Générer : uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30

# --- Limites ---
MAX_URLS_PER_USER=50
